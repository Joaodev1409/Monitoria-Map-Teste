# Copie para .env e ajuste. O .env NÃO vai para o Git (está no .gitignore).

# ---------- Sessão ----------
# Segredo que assina o cookie de sessão. Mínimo de 32 caracteres, aleatório em produção.
# Gere um com:  openssl rand -base64 48
APP_SESSAO_SEGREDO=troque-por-um-segredo-aleatorio-com-mais-de-32-caracteres
# Quanto tempo a sessão dura (padrão: 8h).
# APP_SESSAO_VALIDADE=8h

# ---------- Login com Google ----------
# Crie em https://console.cloud.google.com/apis/credentials
#   → Criar credenciais → ID do cliente OAuth → Aplicativo da Web
#   → Origens JavaScript autorizadas: http://localhost:3000, http://localhost:5173 e a URL de produção
APP_AUTH_GOOGLE_CLIENT_ID=
# Domínios que podem criar conta (separados por vírgula).
APP_AUTH_DOMINIOS_PERMITIDOS=aluno.uepb.edu.br,servidor.uepb.edu.br
# Quem entra já como administrador (separados por vírgula).
APP_AUTH_ADMIN_EMAILS=

# O login é por e-mail institucional + senha, com código de confirmação enviado por e-mail.
# Por isso o envio de e-mail (seção abaixo) é OBRIGATÓRIO em produção.
# Localmente o docker-compose manda tudo para o Mailpit: http://localhost:8025
# O botão do Google é opcional: só aparece se APP_AUTH_GOOGLE_CLIENT_ID estiver preenchido.

# ---------- Limites contra abuso ----------
# APP_LIMITE_SOLICITACOES_ATIVAS=2        pedidos em andamento por aluno
# APP_LIMITE_LOGIN_POR_MINUTO=20          tentativas de login por IP
# APP_LIMITE_SOLICITACOES_POR_HORA=6      pedidos novos por IP

# ---------- Produção (Render/Railway/Fly + Neon) ----------
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<banco>?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# APP_URL_FRONTEND=https://monitoria-map.vercel.app
# APP_CORS_ORIGENS=https://monitoria-map.vercel.app

# ---------- E-mail (Gmail com "senha de app") ----------
# APP_EMAIL_HABILITADO=true
# APP_EMAIL_REMETENTE=Monitoria MAP <seu.email@gmail.com>
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=seu.email@gmail.com
# SPRING_MAIL_PASSWORD=senha-de-app-de-16-letras
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_STARTTLS=true
